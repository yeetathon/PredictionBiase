# AFL Prediction Intelligence — Environment Configuration

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/afl_multi_builder.db

# ── Data paths ────────────────────────────────────────────────────────────
ARTIFACTS_DIR=./data/models
RAW_CACHE_DIR=./data/cache

# ── Sportradar AFL API ────────────────────────────────────────────────────
SPORTRADAR_API_KEY=1HHaESpiAdAMELDQNzk5iC9ZTnKczKl91Pl94hTz
SPORTRADAR_BASE_URL=https://api.sportradar.com/australianrules/trial/v3/en
SPORTRADAR_AFL_COMPETITION_ID=sr:competition:656
SPORTRADAR_AFL_SEASON_ID=

# ── API-Sports AFL API ────────────────────────────────────────────────────
API_SPORTS_KEY=4b2ed393ab9026d9dde728a9148edf23
API_SPORTS_BASE_URL=https://v1.afl.api-sports.io
API_SPORTS_AFL_LEAGUE_ID=1

# ── The Odds API ──────────────────────────────────────────────────────────
ODDS_API_KEY=84091b53c7b1d58314ae959e0d545b1b
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_SPORT=aussierules_afl
ODDS_API_BOOKMAKERS=tab,sportsbet,bet365,unibet,pointsbet,betfair,williamhill,neds

# ── Data Mode (live | cache only — no demo) ───────────────────────────────
DATA_MODE=live

# ── Rate limiting & quota ─────────────────────────────────────────────────
API_RATE_LIMIT_QPS=1.0
API_QUOTA_TOTAL=1000
API_QUOTA_WARN_PCT=0.80
API_QUOTA_REFUSE_PCT=0.95

# ── Cache TTL (hours) ─────────────────────────────────────────────────────
CACHE_TTL_HOURS=6
CACHE_TTL_UPCOMING_HOURS=2
CACHE_TTL_RESULTS_HOURS=24

# ── Scraping / Edge Intelligence ──────────────────────────────────────────
ENABLE_SCRAPING=true
SCRAPE_CACHE_TTL_MINUTES=30
SCRAPE_MAX_AGE_HOURS=6

# ── Sync windows ──────────────────────────────────────────────────────────
UPCOMING_LOOKAHEAD_DAYS=14
RECENT_SETTLEMENT_LOOKBACK_DAYS=7

# ── Model settings ────────────────────────────────────────────────────────
MIN_EDGE_THRESHOLD=0.03
MAX_CORRELATION_SCORE=0.7
MIN_EV_THRESHOLD=0.02
MAX_LEGS_PER_GAME=3
MAX_LEGS_PER_PLAYER=2
MAX_MULTI_LEGS=4
MIN_MULTI_LEGS=2

# ── Training / retraining ─────────────────────────────────────────────────
RETRAIN_MIN_NEW_GAMES=10
RETRAIN_BRIER_DEGRADATION_THRESHOLD=0.02
MODEL_PROMOTION_BRIER_IMPROVEMENT=0.002

# ── Bootstrap ─────────────────────────────────────────────────────────────
ENABLE_BOOTSTRAP_MODE=true
BOOTSTRAP_REPORT_DAYS=30

# ── Backtesting ───────────────────────────────────────────────────────────
BACKTEST_START_SEASON=2021
BACKTEST_END_SEASON=2023
WALK_FORWARD_WINDOW_GAMES=50

# ── Elo ───────────────────────────────────────────────────────────────────
ELO_K_FACTOR=32.0
ELO_INITIAL_RATING=1500.0
ELO_HOME_ADVANTAGE=70.0
