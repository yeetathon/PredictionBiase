# AFL Multi Builder - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/afl_multi_builder.db

# Data paths
DEMO_DATA_DIR=./data/demo
MODEL_ARTIFACTS_DIR=./data/models

# API keys (optional - app works fully without these using demo data)
# AFL_API_KEY=your_key_here
# ODDS_API_KEY=your_key_here
# WEATHER_API_KEY=your_key_here

# Model settings
MIN_EDGE_THRESHOLD=0.03
MAX_CORRELATION_SCORE=0.7
MIN_EV_THRESHOLD=0.02
MAX_LEGS_PER_GAME=3
MAX_LEGS_PER_PLAYER=2
MAX_MULTI_LEGS=4
MIN_MULTI_LEGS=2

# Backtesting
BACKTEST_START_SEASON=2021
BACKTEST_END_SEASON=2023
WALK_FORWARD_WINDOW_GAMES=50
