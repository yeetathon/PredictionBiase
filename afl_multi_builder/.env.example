# AFL Multi Builder - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/afl_multi_builder.db

# Data paths
DEMO_DATA_DIR=./data/demo
ARTIFACTS_DIR=./data/models
RAW_CACHE_DIR=./data/cache

# ── Sportradar API (optional) ─────────────────────────────────────────────
# Leave empty to use demo CSV data. Set to enable live/cached API data.
SPORTRADAR_API_KEY=
SPORTRADAR_BASE_URL=https://api.sportradar.com/afl/trial/v2/en
SPORTRADAR_AFL_COMPETITION_ID=sr:competition:3394
# Set the current AFL season ID once known, e.g. sr:season:98765
SPORTRADAR_AFL_SEASON_ID=

# ── Data Mode ─────────────────────────────────────────────────────────────
# live   = prefer Sportradar API (with cache + quota protection)
# cache  = only use cached API responses, no live calls
# demo   = local demo CSV files only (default, no API key required)
DATA_MODE=demo
ENABLE_DEMO_FALLBACK=true

# ── Rate limiting & quota ─────────────────────────────────────────────────
API_RATE_LIMIT_QPS=1.0
API_QUOTA_TOTAL=1000
API_QUOTA_WARN_PCT=0.80
API_QUOTA_REFUSE_PCT=0.95

# ── Cache TTL (hours) ─────────────────────────────────────────────────────
CACHE_TTL_HOURS=6
CACHE_TTL_UPCOMING_HOURS=2
CACHE_TTL_RESULTS_HOURS=24

# ── Sync windows ──────────────────────────────────────────────────────────
UPCOMING_LOOKAHEAD_DAYS=14
RECENT_SETTLEMENT_LOOKBACK_DAYS=7

# ── Model settings ────────────────────────────────────────────────────────
MIN_EDGE_THRESHOLD=0.03
MAX_CORRELATION_SCORE=0.7
MIN_EV_THRESHOLD=0.02
MAX_LEGS_PER_GAME=3
MAX_LEGS_PER_PLAYER=2
MAX_MULTI_LEGS=4
MIN_MULTI_LEGS=2

# ── Training / retraining ─────────────────────────────────────────────────
RETRAIN_MIN_NEW_GAMES=10
RETRAIN_BRIER_DEGRADATION_THRESHOLD=0.02
MODEL_PROMOTION_BRIER_IMPROVEMENT=0.002

# ── Bootstrap ─────────────────────────────────────────────────────────────
ENABLE_BOOTSTRAP_MODE=true
BOOTSTRAP_REPORT_DAYS=30

# ── Backtesting ───────────────────────────────────────────────────────────
BACKTEST_START_SEASON=2021
BACKTEST_END_SEASON=2023
WALK_FORWARD_WINDOW_GAMES=50

# ── Elo ───────────────────────────────────────────────────────────────────
ELO_K_FACTOR=32.0
ELO_INITIAL_RATING=1500.0
ELO_HOME_ADVANTAGE=70.0
