# AFL Prediction Intelligence — Environment Configuration
# Copy this file to .env and fill in your API keys.
#
# This is a live-data system. There is no demo mode.
# ALL predictions require real API credentials.
#
# ── REQUIRED ──────────────────────────────────────────────────────────────
# Without these two settings the pipeline will not start.

# Sportradar AFL API (required)
# Get a key at https://developer.sportradar.com/
SPORTRADAR_API_KEY=

# Sportradar AFL Season ID (required)
# Find the current season ID by calling:
#   GET https://api.sportradar.com/australianrules/trial/v3/en/competitions/sr:competition:656/seasons.json?api_key=<key>
# The season ID looks like: sr:season:XXXXXX
SPORTRADAR_AFL_SEASON_ID=

# ── OPTIONAL — RECOMMENDED ────────────────────────────────────────────────
# These unlock bookmaker odds comparison and edge detection.

# The Odds API (optional — enables live bookmaker odds and edge calculation)
# Get a free key at https://the-odds-api.com/
ODDS_API_KEY=

# API-Sports AFL (optional — supplementary fixtures/teams)
# API_SPORTS_KEY=

# ── APPLICATION ───────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ── DATABASE ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/afl_multi_builder.db

# ── DATA PATHS ────────────────────────────────────────────────────────────
ARTIFACTS_DIR=./data/models
RAW_CACHE_DIR=./data/cache

# ── SPORTRADAR ADVANCED ───────────────────────────────────────────────────
SPORTRADAR_BASE_URL=https://api.sportradar.com/australianrules/trial/v3/en
SPORTRADAR_AFL_COMPETITION_ID=sr:competition:656

# ── ODDS API ADVANCED ─────────────────────────────────────────────────────
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_SPORT=aussierules_afl
ODDS_API_BOOKMAKERS=tab,sportsbet,bet365,unibet,pointsbet,betfair,williamhill,neds

# ── DATA MODE (live | cache only — no demo) ───────────────────────────────
# live  = fetch from Sportradar API with cache + quota protection (recommended)
# cache = only use cached Sportradar responses (no new API calls)
DATA_MODE=live

# ── RATE LIMITING & QUOTA ─────────────────────────────────────────────────
API_RATE_LIMIT_QPS=1.0
API_QUOTA_TOTAL=1000
API_QUOTA_WARN_PCT=0.80
API_QUOTA_REFUSE_PCT=0.95

# ── CACHE TTL (hours) ─────────────────────────────────────────────────────
CACHE_TTL_HOURS=6
CACHE_TTL_UPCOMING_HOURS=2
CACHE_TTL_RESULTS_HOURS=24

# ── SCRAPING / EDGE INTELLIGENCE ─────────────────────────────────────────
ENABLE_SCRAPING=true
SCRAPE_CACHE_TTL_MINUTES=30
SCRAPE_MAX_AGE_HOURS=6

# ── SYNC WINDOWS ──────────────────────────────────────────────────────────
UPCOMING_LOOKAHEAD_DAYS=14
RECENT_SETTLEMENT_LOOKBACK_DAYS=7

# ── MODEL SETTINGS ────────────────────────────────────────────────────────
MIN_EDGE_THRESHOLD=0.03
MAX_CORRELATION_SCORE=0.7
MIN_EV_THRESHOLD=0.02
MAX_LEGS_PER_GAME=3
MAX_LEGS_PER_PLAYER=2
MAX_MULTI_LEGS=4
MIN_MULTI_LEGS=2

# ── TRAINING / RETRAINING ─────────────────────────────────────────────────
RETRAIN_MIN_NEW_GAMES=10
RETRAIN_BRIER_DEGRADATION_THRESHOLD=0.02
MODEL_PROMOTION_BRIER_IMPROVEMENT=0.002

# ── BOOTSTRAP ─────────────────────────────────────────────────────────────
ENABLE_BOOTSTRAP_MODE=true
BOOTSTRAP_REPORT_DAYS=30

# ── BACKTESTING ───────────────────────────────────────────────────────────
BACKTEST_START_SEASON=2021
BACKTEST_END_SEASON=2023
WALK_FORWARD_WINDOW_GAMES=50

# ── ELO ───────────────────────────────────────────────────────────────────
ELO_K_FACTOR=32.0
ELO_INITIAL_RATING=1500.0
ELO_HOME_ADVANTAGE=70.0
